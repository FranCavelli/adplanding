---
// =============================================================
//  Sección Instagram — últimas publicaciones vía Behold
//    - Feed JSON conectado a @aguasdelparquelincoln en behold.so
//    - La grilla se arma acá (sin widget ni marca de Behold) y
//      se actualiza sola cuando suben algo nuevo.
// =============================================================

const IG_HANDLE = 'aguasdelparquelincoln';
const IG_URL = `https://instagram.com/${IG_HANDLE}`;

const BEHOLD_FEED_URL = 'https://feeds.behold.so/P4fwDUaBo26H7giUbJWN';
const POSTS = 4;
---

<section id="instagram" class="relative py-24 lg:py-32 bg-gradient-to-b from-white to-brand-foam/50 overflow-hidden">
  <div class="section">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 reveal">
      <div class="max-w-2xl">
        <span class="chip inline-flex items-center gap-2">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          Instagram
        </span>
        <h2 class="mt-4 font-display text-4xl sm:text-5xl font-extrabold tracking-tight">
          Aguas del Parque
          <span class="text-gradient">en vivo.</span>
        </h2>
        <p class="mt-4 text-brand-ink/70 text-lg">
          Mirá nuestras novedades, análisis, eventos y promociones directamente en nuestro Instagram.
        </p>
      </div>
    </div>

    <div class="mt-14 reveal">
      {/* Placeholders mientras carga; el script los reemplaza por los posts */}
      {/* En mobile se ven 2 (lado a lado); desde sm, las 4 */}
      <div id="ig-feed" class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4" data-feed={BEHOLD_FEED_URL} data-posts={POSTS}>
        {
          Array.from({ length: POSTS }).map((_, i) => (
            <div class:list={['aspect-square rounded-2xl bg-brand-foam animate-pulse', i >= 2 && 'hidden sm:block']} />
          ))
        }
      </div>

      <div class="mt-10 text-center reveal">
        <a
          href={IG_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold text-white shadow-glow bg-gradient-to-br from-pink-500 via-rose-500 to-amber-500 hover:from-pink-600 hover:via-rose-600 hover:to-amber-600 transition-colors"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          Ir al Instagram
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (async () => {
    const grid = document.getElementById('ig-feed');
    if (!grid) return;
    try {
      const res = await fetch(grid.dataset.feed);
      const data = await res.json();
      const posts = (data.posts || []).slice(0, Number(grid.dataset.posts));
      if (!posts.length) throw new Error('feed vacío');

      const el = (tag, cls) => {
        const n = document.createElement(tag);
        if (cls) n.className = cls;
        return n;
      };

      grid.replaceChildren(
        ...posts.map((post, i) => {
          const caption = (post.prunedCaption || post.caption || '').split('\n')[0];
          const src = post.sizes?.medium?.mediaUrl || post.thumbnailUrl || post.mediaUrl;

          const a = el('a', 'ig-card group relative aspect-square overflow-hidden rounded-2xl ring-1 ring-brand-sky/10 shadow-sm hover:shadow-deep transition-shadow');
          a.href = post.permalink;
          a.target = '_blank';
          a.rel = 'noopener';
          if (i >= 2) a.classList.add('hidden', 'sm:block');

          const img = el('img', 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110');
          img.src = src;
          img.alt = caption || 'Publicación de Instagram';
          img.loading = 'lazy';

          const shade = el('div', 'absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity');

          const body = el('div', 'absolute inset-0 p-4 flex flex-col justify-end');
          const p = el('p', 'text-white text-sm font-semibold drop-shadow line-clamp-2 translate-y-2 group-hover:translate-y-0 transition-transform');
          p.textContent = caption;
          const cta = el('div', 'mt-2 text-white/90 text-xs opacity-0 group-hover:opacity-100 transition-opacity');
          cta.textContent = post.mediaType === 'VIDEO' ? 'Ver el reel en Instagram →' : 'Ver en Instagram →';
          body.append(p, cta);

          a.append(img, shade, body);
          return a;
        })
      );
    } catch (e) {
      // Si el feed falla, no dejamos placeholders colgados: queda solo el botón.
      grid.remove();
    }
  })();
</script>
