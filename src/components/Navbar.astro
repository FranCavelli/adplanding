---
const nav = [
  { href: '#instagram', label: 'Instagram' },
  { href: '#productos', label: 'Productos' },
  { href: '#calculadora', label: 'Calculadora' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso', label: 'Nuestro proceso' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#contacto', label: 'Contacto' },
];
const orderUrl = 'https://aguas-del-parque.aquaenvio.com/';
const base = import.meta.env.BASE_URL;
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
>
  <div class="section">
    <div
      class="relative mt-3 flex items-center justify-between rounded-2xl border border-white/60 bg-white/75 backdrop-blur-xl shadow-[0_10px_40px_-20px_rgba(10,42,110,0.35)] pl-2 pr-3 py-2"
    >
      <a href="#inicio" aria-label="Aguas del Parque — Inicio" class="flex items-center gap-3 group">
        <img
          src={`${base}minilogo.png`}
          alt="Aguas del Parque"
          class="h-11 w-auto transition-transform group-hover:scale-[1.03]"
        />
      </a>

      <nav class="hidden lg:flex items-center gap-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-medium text-brand-ink/80 hover:text-brand-deep transition-colors relative after:absolute after:left-3 after:right-3 after:-bottom-0.5 after:h-[2px] after:rounded-full after:bg-brand-sky after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:origin-left"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          id="nav-order"
          href={orderUrl}
          target="_blank"
          rel="noopener"
          class="justify-center overflow-hidden absolute left-1/2 -translate-x-1/2 lg:static lg:translate-x-0 inline-flex btn-primary h-10 py-0 px-4 text-sm whitespace-nowrap"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1.5" /><circle cx="19" cy="21" r="1.5" /><path d="M2.5 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.5a2 2 0 0 0 2-1.6L21 7H6" /></svg>
          Pedir ahora
        </a>
        <button
          id="nav-toggle"
          aria-label="Abrir menú"
          class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-xl border border-brand-royal/15 bg-white/70"
        >
          <svg class="h-5 w-5 text-brand-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="lg:hidden hidden mt-2 rounded-2xl border border-white/70 bg-white/90 backdrop-blur-xl p-3 shadow-deep"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="block px-3 py-2 rounded-lg text-brand-ink hover:bg-brand-foam"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 8) nav.classList.add('is-scrolled');
    else nav.classList.remove('is-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ===== Mobile: "Pedir ahora" arranca ocupando todo el hueco
  // entre el logo y el burger, y después se achica a su tamaño =====
  const order = document.getElementById('nav-order');
  const bar = order?.parentElement?.parentElement;
  const logo = bar?.querySelector('a[href="#inicio"]');
  const burger = document.getElementById('nav-toggle');
  if (
    order && bar && logo && burger &&
    window.matchMedia('(max-width: 1023px)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const natural = order.offsetWidth;
    const gap = 12;
    // Mitad más chica de los dos lados, para que siga centrado
    const side = Math.max(
      logo.getBoundingClientRect().right - bar.getBoundingClientRect().left,
      bar.getBoundingClientRect().right - burger.getBoundingClientRect().left,
    );
    const wide = bar.clientWidth - 2 * (side + gap);
    if (wide > natural) {
      order.style.width = `${wide}px`;
      requestAnimationFrame(() => {
        setTimeout(() => {
          order.style.transition = 'width 700ms cubic-bezier(0.22, 1, 0.36, 1)';
          order.style.width = `${natural}px`;
          order.addEventListener('transitionend', () => {
            order.style.width = '';
            order.style.transition = '';
          }, { once: true });
        }, 1200);
      });
    }
  }

  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => menu.classList.add('hidden')),
  );

  // ===== Scroll-spy: marca el link activo según la sección visible =====
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '#site-nav a[href^="#"], #mobile-menu a[href^="#"]',
    ),
  ).filter((a) => a.getAttribute('href') !== '#inicio');

  const sectionIds = Array.from(
    new Set(navLinks.map((a) => (a.getAttribute('href') || '').replace('#', ''))),
  ).filter(Boolean);

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);

  const intersecting = new Set<HTMLElement>();
  const setActive = (id: string | null) => {
    navLinks.forEach((a) => {
      a.classList.toggle('is-active', a.getAttribute('href') === `#${id}`);
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) intersecting.add(e.target as HTMLElement);
        else intersecting.delete(e.target as HTMLElement);
      });
      const sorted = [...intersecting].sort(
        (a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top,
      );
      setActive(sorted[0]?.id ?? null);
    },
    {
      rootMargin: '-30% 0px -60% 0px',
      threshold: 0,
    },
  );

  sections.forEach((s) => observer.observe(s));
</script>

<style>
  #site-nav.is-scrolled > div > div {
    box-shadow: 0 20px 60px -30px rgba(10, 42, 110, 0.45);
  }
  /* Active link state (set by scroll-spy) */
  #site-nav nav a.is-active {
    color: rgb(10 42 110); /* brand-deep */
  }
  #site-nav nav a.is-active::after {
    transform: scaleX(1);
  }
  #mobile-menu a.is-active {
    background-color: rgb(234 247 251); /* brand-foam */
    color: rgb(10 42 110);
    font-weight: 600;
  }
</style>
